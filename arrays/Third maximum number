import java.util.*;
class Solution {
    public int thirdMax(int[] nums) {
        Arrays.sort(nums);
        int max1 = nums[0];
        int max2 = nums[0];
        int max3 = nums[0];
        
        for(int i : nums){
            if(i > max1){
                max3 = max2;
                max2 = max1;
                max1 = i;
            }
            else if(i < max1 && max2 < i){
                max3 = max2;
                max2 = i;
            }
            else if(max2 > i && max3 < i){
                max3 = i;
            }
        }

        if(max3 == max2){
            return max1;
        }
        else return max3;
    }
}
