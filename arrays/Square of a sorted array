import java.util.*;
class Solution {
    public int[] sortedSquares(int[] nums) {
        int left = 0;
        int right = nums.length - 1;
        while(left < right){
            nums[left] *= nums[left];
            nums[right] *= nums[right];
            left++;
            right--;
        }
        if(left == right){
            nums[left] *= nums[left];
        }
        Arrays.sort(nums);
        return nums;
    }
}
