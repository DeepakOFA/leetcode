class Solution {
    public String reverseVowels(String s) {
        
        char[] c = s.toCharArray();
        int left = 0;
        int right = c.length - 1;

        while(left < right){
            char c1 = c[left];
            char c2 = c[right];

            if(String.valueOf(c1).matches("[aeiouAEIOU]") && String.valueOf(c2).matches("[aeiouAEIOU]")){
                char temp = c[left];
                c[left] = c[right];
                c[right] = temp;
                left++;
                right--;
            }

            else if(String.valueOf(c1).matches("[aeiouAEIOU]")){
                right--;
            }

            else if(String.valueOf(c2).matches("[aeiouAEIOU]")){
                left++;
            }

            else{
                left++;
                right--;
            }
        }

        s = new String(c);

        return s;
    }
}
